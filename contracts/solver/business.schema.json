    "real_case_create": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "board": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[2-9TJQKA][cdhs]$"
          }
        },
        "pot": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "description": "根底池，整数 centibb；100=1bb"
        },
        "stack": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "description": "当前根节点双方有效后手，整数 centibb；历史投入不计入后手"
        },
        "betPercent": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^\\d+(?:\\.\\d+)?$"
        },
        "tree": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit-river/v2"
            },
            "lines": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "check",
                            "fold",
                            "call"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "bet",
                            "raise",
                            "all-in"
                          ]
                        },
                        "amount": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "kind",
                        "amount"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "kind",
            "lines"
          ],
          "additionalProperties": false
        },
        "ranges": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "description": "具体组合的输入权重，万分比单位；10000=100%，不是行动频率"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "description": "具体组合的输入权重，万分比单位；10000=100%，不是行动频率"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "workspaceId",
        "requestId",
        "expectedRevision",
        "name",
        "board",
        "pot",
        "stack",
        "betPercent",
        "ranges"
      ],
      "additionalProperties": false
    },
