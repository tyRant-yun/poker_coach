{
  "name": "riverline-poker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --import tsx runtime/server.ts --serve",
    "e2e:first-round": "node scripts/test-first-round.mjs",
    "rules:setup": "node scripts/setup-rules.mjs",
    "bot:setup": "node scripts/setup-bot.mjs",
    "test:game": "node --import tsx --test tests/game/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "runtime": "node --import tsx runtime/server.ts",
    "mcp": "node scripts/mcp.mjs",
    "test:mcp": "node --import tsx --test tests/mcp/*.test.ts",
    "solver:build": "node scripts/solver-tool.mjs build",
    "solver:check": "npm run format:solver:check && node scripts/solver-tool.mjs fmt && node scripts/solver-tool.mjs clippy && node scripts/solver-tool.mjs test",
    "format:solver:check": "prettier --check contracts/solver/*.ts src/modules/analysis/real-domain.ts src/modules/analysis/RealAnalysisPage.tsx src/modules/analysis/RealAnalysisPage.module.css runtime/analysis/*.ts runtime/engines/*.ts runtime/mcp.ts scripts/solver-*.mjs scripts/solver-contract.ts tests/solver/*.test.ts tests/mcp/real-*.test.ts tests/journeys/real-solver.spec.ts",
    "test:solver": "node --import tsx --test tests/solver/*.test.ts",
    "solver:contract": "node --import tsx scripts/solver-contract.ts",
    "benchmark:solver:small": "node scripts/solver-benchmark.mjs",
    "benchmark:solver:tree": "node scripts/solver-benchmark.mjs --tree",
    "benchmark:solver:turn": "node scripts/solver-turn-benchmark.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
